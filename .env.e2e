# E2E Testing Environment (.env.e2e)
# Use this for running end-to-end tests with Playwright

# Database Configuration - Use E2E test database
DATABASE_URL="mongodb://localhost:27017/geniuzlab-e2e"

# Authentication
AUTH_SECRET="e2e-test-secret-key-minimum-32-characters-long-123"
AUTH_URL="http://localhost:3000"

# Admin Credentials for E2E tests
ADMIN_EMAIL="e2e-admin@geniuzlab.test"
ADMIN_PASSWORD="E2ETestPassword123!"

# Backend API
BACKEND_URL="http://localhost:3001"

# Optional image storage
BLOB_READ_WRITE_TOKEN="e2e-test-token"

# Node environment
NODE_ENV="test"

# Playwright specific
PLAYWRIGHT_TEST_BASE_URL="http://localhost:3000"
PLAYWRIGHT_SLOW_MO="100"
PLAYWRIGHT_HEADLESS="true"
