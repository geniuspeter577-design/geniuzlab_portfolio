# Test Environment (.env.test)
# Use this for running unit and integration tests

# Database Configuration - Use test MongoDB database
DATABASE_URL="mongodb://localhost:27017/geniuzlab-test"

# For MongoDB Atlas test instance (optional):
# DATABASE_URL="mongodb+srv://test_user:test_pass@test-cluster.mongodb.net/geniuzlab-test"

# Authentication
AUTH_SECRET="test-secret-key-minimum-32-characters-long-1234567890"
AUTH_URL="http://localhost:3000"

# Admin Credentials for testing
ADMIN_EMAIL="test-admin@geniuzlab.test"
ADMIN_PASSWORD="TestPassword123!"

# Backend API
BACKEND_URL="http://localhost:3001"

# Optional image storage
BLOB_READ_WRITE_TOKEN="test-token"

# Node environment
NODE_ENV="test"
