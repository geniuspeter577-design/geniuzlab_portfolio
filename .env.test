# Test Environment (.env.test)
# Use this for running unit and integration tests

# Database Configuration - Use test PostgreSQL database
DATABASE_URL="postgresql://test:test@localhost:5432/geniuzlab_test"

# Authentication
AUTH_SECRET="test-secret-key-minimum-32-characters-long-1234567890"
NEXTAUTH_URL="http://localhost:3000"

# Admin Credentials for testing
ADMIN_EMAIL="test-admin@geniuzlab.test"
ADMIN_PASSWORD_HASH="$2a$10$9MbPbHW7.KkRJGhFLqr1y.HNFYdHPKQjQvuBfVCp9vfAWGpDY4BqC"

# Backend API
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Optional image storage - Vercel Blob
BLOB_READ_WRITE_TOKEN="test-token"

# Cloudinary (optional for testing)
# Use a test account or mock these in tests
CLOUDINARY_CLOUD_NAME="test-cloud"
CLOUDINARY_API_KEY="test-api-key"
CLOUDINARY_API_SECRET="test-api-secret"

# Node environment
NODE_ENV="test"
