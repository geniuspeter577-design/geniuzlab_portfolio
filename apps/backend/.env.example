# apps/backend/.env.local
#
# The backend is the single source of truth for all secrets: database
# access, admin auth, and image storage. Nothing here should also live in
# apps/web/.env.local.

# Server
NODE_ENV=development
PORT=3001

# Comma-separated list of origins allowed to call this API.
# Local dev:   http://localhost:3000
# Production:  https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:3000

# Database (MongoDB) — same connection string used by apps/web for reads,
# but only the backend writes to it.
DATABASE_URL=mongodb://localhost:27017/geniuzlab

# Admin auth (JWT-based, issued by POST /api/auth/login)
# Generate AUTH_SECRET with: openssl rand -hex 32
AUTH_SECRET=
ADMIN_EMAIL=geniuzlab577@gmail.com
# bcrypt hash of the admin password — never store the plaintext password.
# Generate with: node -e "const bcrypt=require('bcryptjs'); console.log(bcrypt.hashSync('your-password', 10));"
ADMIN_PASSWORD_HASH=
# Optional SMTP settings for one-time admin password reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Image & video storage — both optional, choose one or both.
# Cloudinary — https://cloudinary.com/ (Dashboard > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Vercel Blob — https://vercel.com/docs/storage/vercel-blob (fallback if Cloudinary isn't configured)
BLOB_READ_WRITE_TOKEN=
