{
  "name": "@geniuzlab/backend",
  "version": "1.0.0",
  "description": "GeniuzLab Portfolio - Backend API (Express + Prisma)",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "ts-node ../../prisma/seed.ts"
  },
  "dependencies": {
    "@geniuzlab/shared": "*",
    "@prisma/client": "^6.13.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20",
    "@types/supertest": "^7.2.1",
    "@vitest/ui": "^4.1.11",
    "eslint": "^9",
    "jest": "^30.5.1",
    "playwright": "^1.62.1",
    "prisma": "^6.13.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
