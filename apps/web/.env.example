# apps/web/.env.local
#
# The frontend no longer holds any secrets. Auth, admin credentials, and
# Cloudinary uploads all live in apps/backend now (see apps/backend/.env.example).
# apps/web only needs read access to the database (for public pages) and
# the backend's public URL (so the browser can call it directly).

# Public URL of the backend API. Must be reachable from the BROWSER
# (not just the Next.js server), since admin login/CRUD/upload calls go
# directly from client components to the backend.
# Local dev:   http://localhost:3001
# Production:  https://your-backend.onrender.com
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
