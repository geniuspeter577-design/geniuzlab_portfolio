# .env.e2e.example
#
# Not auto-loaded by playwright.config.ts — copy the relevant values into
# apps/web/.env.local / apps/backend/.env.local when running e2e tests
# against a dedicated database, or export them in your shell/CI.

# Backend auth (auth lives in apps/backend)
AUTH_SECRET=e2e-secret-at-least-32-characters-long
ADMIN_EMAIL=admin@geniuzlab.com
ADMIN_PASSWORD_HASH=

NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
NODE_ENV=test

# Playwright specific
PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
PLAYWRIGHT_SLOW_MO=0
PLAYWRIGHT_HEADLESS=true
