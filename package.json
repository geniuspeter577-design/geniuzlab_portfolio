{
  "name": "geniuzlab_portfolio",
  "version": "1.0.0",
  "description": "GeniuzLab Portfolio - Monorepo with Web, Backend, and Shared packages",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/backend",
    "packages/shared"
  ],
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:backend": "cd apps/backend && npm run dev",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:backend\"",
    "build": "npm --workspaces run build",
    "start": "npm --workspaces run start",
    "lint": "npm --workspaces run lint",
    "test": "npm --workspaces run test",
    "test:watch": "npm --workspaces run test:watch",
    "test:coverage": "npm --workspaces run test:coverage",
    "test:e2e": "cd apps/web && npx playwright test",
    "test:e2e:ui": "cd apps/web && npx playwright test --ui",
    "db:migrate": "cd apps/backend && npm run db:migrate",
    "db:push": "cd apps/backend && npm run db:push",
    "db:seed": "cd apps/backend && npm run db:seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "next-cloudinary": "^6.18.8"
  }
}
