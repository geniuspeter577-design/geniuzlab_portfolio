# Database Configuration
# For MongoDB:
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/geniuzlab?retryWrites=true&w=majority"

# For PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/geniuzlab"

# Authentication
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
AUTH_URL="http://localhost:3000"

# Admin Credentials (used for database seeding)
# Set these before running `npm run db:seed`
ADMIN_EMAIL="admin@geniuzlab.com"
ADMIN_PASSWORD="ChangeMe123!"

# =============================================================================
# IMAGE & VIDEO STORAGE - Choose One or Both
# =============================================================================

# VERCEL BLOB (Optional - use alongside Cloudinary)
# Get token from: https://vercel.com/docs/storage/vercel-blob
# Free tier: 1000GB storage, 4.5GB per file
# Features: Simple, serverless, integrated with Vercel
BLOB_READ_WRITE_TOKEN=""

# CLOUDINARY (Optional - modern CDN with transformation support)
# Sign up at: https://cloudinary.com/
# Free tier: 2GB storage, 2GB per file, transformations, video support
# 
# Get these values from: Cloudinary Dashboard > Settings > API Keys

# Your Cloudinary Cloud Name
CLOUDINARY_CLOUD_NAME=""

# Your Cloudinary API Key
CLOUDINARY_API_KEY=""

# Your Cloudinary API Secret
CLOUDINARY_API_SECRET=""

# Optional: Preset name for unsigned uploads (frontend direct)
# CLOUDINARY_UPLOAD_PRESET=""

# Backend API
BACKEND_URL="http://localhost:3001"

