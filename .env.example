# =============================================================================
# DATABASE — MongoDB (required, matches prisma/schema.prisma)
# =============================================================================
# Get a free cluster at https://www.mongodb.com/cloud/atlas
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/geniuzlab?retryWrites=true&w=majority"

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
AUTH_URL="http://localhost:3000"

ADMIN_EMAIL="admin@geniuzlab.com"

# bcrypt hash of the admin password — the app never reads a plaintext password.
# Generate with:
#   node -e "const bcrypt=require('bcryptjs'); console.log(bcrypt.hashSync('your-password', 10));"
# Used both by auth.ts (login) and prisma/seed.ts (npm run db:seed).
ADMIN_PASSWORD_HASH="replace-with-a-bcrypt-hash"

# =============================================================================
# IMAGE & VIDEO STORAGE — choose one or both, both are optional
# =============================================================================

# Vercel Blob — https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""

# Cloudinary — https://cloudinary.com/ (Dashboard > Settings > API Keys)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
