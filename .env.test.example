# .env.test.example
#
# Not auto-loaded by any config in this repo (no vitest/jest config
# references .env.test) — copy the relevant values into
# apps/web/.env.local / apps/backend/.env.local when running tests
# against a dedicated test database, or export them in your shell/CI.

# Database Configuration - MongoDB test database
DATABASE_URL=mongodb://localhost:27017/geniuzlab_test

# Backend auth (only relevant for apps/backend tests)
AUTH_SECRET=test-secret-at-least-32-characters-long
ADMIN_EMAIL=admin@geniuzlab.com
ADMIN_PASSWORD_HASH=

NODE_ENV=test
